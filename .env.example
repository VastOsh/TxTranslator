# Groq API key — get one for free at https://console.groq.com
GROQ_API_KEY=

# Cloudflare Worker backing the wallet NFT portfolio (cloudflare/talis-profile-proxy).
# Optional: without it the app still works, but NFT metadata and images are fetched
# straight from public IPFS gateways, which rate-limit datacenter IPs hard — expect
# most thumbnails to fail to resolve. With it, both are cached at Cloudflare's edge.
# TALIS_PROXY_URL is the deployed Worker URL; TALIS_PROXY_SECRET must match the
# Worker's PROXY_SECRET and is only used for the Talis profile-id lookup.
TALIS_PROXY_URL=
TALIS_PROXY_SECRET=
